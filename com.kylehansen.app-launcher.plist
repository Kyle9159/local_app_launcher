<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kylehansen.app-launcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/kylehansen/.nvm/versions/node/v24.14.0/bin/node</string>
    <string>/Users/kylehansen/repos/app-launcher/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kylehansen/repos/app-launcher</string>

  <!-- Start automatically on login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if it crashes -->
  <key>KeepAlive</key>
  <true/>

  <!-- Log output -->
  <key>StandardOutPath</key>
  <string>/tmp/app-launcher.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/app-launcher.log</string>

  <!-- Only bind to localhost, low footprint -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/kylehansen</string>
    <key>PATH</key>
    <string>/Users/kylehansen/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
